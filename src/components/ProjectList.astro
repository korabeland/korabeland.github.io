---
// Numbered editorial project list (DESIGN.md "Layout: Projects"). Filters to
// status === 'live' and sorts per the resolved semantic in src/lib/projects.ts,
// then renders one ProjectRow per entry with a "NN / total" mono index.
import { getCollection } from 'astro:content';
import ProjectRow from './ProjectRow.astro';
import { sortLiveProjects, formatIndex } from '../lib/projects';

const allProjects = await getCollection('projects');
const liveProjects = sortLiveProjects(allProjects.map((entry) => entry.data));
const total = liveProjects.length;
---
<div class="project-list">
    {total === 0 ? (
        // Not "coming soon" — R6/AE4 explicitly rule out placeholder/
        // coming-soon copy for the curated set (only live public repos may
        // appear). This is a genuine empty-list state, not a placeholder.
        <p class="project-list__empty">No projects live yet.</p>
    ) : (
        liveProjects.map((project, i) => (
            <ProjectRow
                index={formatIndex(i + 1, total)}
                name={project.name}
                hook={project.hook}
                tech={project.tech}
                repo_url={project.repo_url}
            />
        ))
    )}
</div>

<script>
    // Scroll reveal for project rows: subtle, once-only, and JS-gated (the
    // `js` class) so content is fully visible when JS is disabled. Rows that
    // are already in view on load reveal immediately.
    document.documentElement.classList.add('js');

    const rows = document.querySelectorAll('.project-row');
    rows.forEach((row) => row.classList.add('reveal'));

    if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.setAttribute('data-visible', '');
                        observer.unobserve(entry.target);
                    }
                });
            },
            { threshold: 0.15 }
        );
        rows.forEach((row) => observer.observe(row));
    } else {
        rows.forEach((row) => row.setAttribute('data-visible', ''));
    }
</script>

<style>
    .project-list {
        max-width: var(--max-width);
    }

    .project-list__empty {
        padding: var(--row-padding-y) 0;
        border-top: 1px solid var(--border);
        color: var(--text-muted);
        font-family: var(--font-body);
    }
</style>
